# Cloudflare Pages headers. Files are not fingerprinted, so nothing is marked immutable.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/city/*
  Cache-Control: no-cache
/brand/*
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
# The dashboard files sit one folder down, where /*.css and /*.js do not reach: without this a browser kept m.css and m.js for four hours.
/m/*
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=600
/img/*
  Cache-Control: public, max-age=86400
# Shell files are not fingerprinted, so a browser must revalidate them on every load (a cheap 304): a day-long max-age here
# left visitors with yesterday's app.js under today's index.html on 2026-11-22 and the page crashed. index.html also carries
# ?v=<hash> on its own script and style links (tools/sw-version.js), so a new deploy is fetched fresh by every browser.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.svg
  Cache-Control: public, max-age=0, must-revalidate
/map-style.json
  Cache-Control: public, max-age=0, must-revalidate
/map-style-dark.json
  Cache-Control: public, max-age=0, must-revalidate
/og.png
  Cache-Control: public, max-age=86400
# MapLibre and the fonts are pinned by path (vendor/maplibre-gl-4.7.1/, fonts/<name>-<subset>-<weight>.woff2): never change in place.
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
