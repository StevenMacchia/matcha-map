{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Events file",
  "description": "data/events.json: a generated timestamp and a list of events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "events"],
  "properties": {
    "generated": { "type": "string", "format": "date-time" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "brand", "source_id", "handle", "source_url", "title", "start", "end", "tz", "all_day", "venue", "address", "city", "state", "zip", "lat", "lng", "geocode_source", "confidence", "status", "last_seen", "first_seen", "extracted_by"],
      "properties": {
        "id": { "type": "string", "description": "Hash of source id + start + venue." },
        "brand": { "type": "string" },
        "source_id": { "type": "string" },
        "handle": { "type": ["string", "null"] },
        "source_url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "start": { "type": "string", "format": "date-time", "description": "ISO 8601 with offset, local to the venue." },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "tz": { "type": "string", "description": "IANA zone, e.g. America/Los_Angeles." },
        "all_day": { "type": "boolean" },
        "venue": { "type": "string" },
        "address": { "type": "string", "description": "Street." },
        "city": { "type": "string" },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "zip": { "type": ["string", "null"], "pattern": "^[0-9]{5}(-[0-9]{4})?$" },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "geocode_source": { "enum": ["nominatim", "mapbox", "manual", "none"] },
        "confidence": { "enum": ["confirmed", "likely", "unsure"] },
        "status": { "enum": ["upcoming", "past", "cancelled"] },
        "last_seen": { "type": "string", "format": "date-time" },
        "first_seen": { "type": "string", "format": "date-time" },
        "extracted_by": { "enum": ["rule", "llm", "manual"] }
      }
    }
  }
}
