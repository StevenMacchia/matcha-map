{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Events file",
  "description": "data/events.json: a generated timestamp and a list of events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated",
    "events"
  ],
  "properties": {
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brand",
        "source_id",
        "kind",
        "category",
        "kind",
        "category",
        "handle",
        "source_url",
        "title",
        "start",
        "end",
        "tz",
        "all_day",
        "venue",
        "address",
        "city",
        "state",
        "zip",
        "lat",
        "lng",
        "geocode_source",
        "approx",
        "confidence",
        "status",
        "last_seen",
        "first_seen",
        "extracted_by",
        "image",
        "posts",
        "menu",
        "price",
        "description",
        "links",
        "image_url",
        "series"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Hash of source id + start + venue."
        },
        "brand": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "popup",
            "cafe",
            "venue",
            "tea-brand",
            "organizer",
            "festival"
          ],
          "description": "Copied from the source. The site shows popup by default. See data/KINDS.md."
        },
        "category": {
          "enum": [
            "matcha",
            "coffee",
            "boba",
            "bakery",
            "dessert",
            "other"
          ],
          "description": "Copied from the source. The site shows matcha by default."
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 with offset, local to the venue."
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tz": {
          "type": "string",
          "description": "IANA zone, e.g. America/Los_Angeles."
        },
        "all_day": {
          "type": "boolean"
        },
        "venue": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "description": "Street."
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "zip": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "geocode_source": {
          "enum": [
            "nominatim",
            "nominatim-venue",
            "mapbox",
            "manual",
            "yelp",
            "none"
          ]
        },
        "approx": {
          "type": "boolean",
          "description": "True when no place was found and the pin sits at the city's centre; the site draws it as an approximate marker."
        },
        "confidence": {
          "enum": [
            "confirmed",
            "likely",
            "unsure"
          ]
        },
        "status": {
          "enum": [
            "upcoming",
            "past",
            "cancelled"
          ]
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "extracted_by": {
          "enum": [
            "rule",
            "llm",
            "manual",
            "sweep"
          ],
          "description": "sweep: promoted from a hand-researched data/review/sweep-*.json file."
        },
        "image": {
          "description": "The post or page photo, with credit; null when the source gives none.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "local",
                "credit",
                "width",
                "height"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The remote image."
                },
                "local": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^img/events/[A-Za-z0-9._-]+$",
                  "description": "Downloaded copy, path under site/."
                },
                "credit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Brand handle or source host."
                },
                "width": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "height": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              }
            }
          ]
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "A picture url straight from the Instagram Graph API (shown without downloading it). Refreshed on every read because Meta's urls expire; the site falls back to the drawn card when it fails."
        },
        "posts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instagram",
            "tiktok",
            "other"
          ],
          "properties": {
            "instagram": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "tiktok": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "other": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          }
        },
        "menu": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "description": "Flavors and items the source names; empty when unknown."
        },
        "price": {
          "type": [
            "string",
            "null"
          ],
          "description": "As stated, e.g. $7-9, from $6, free."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Cleaned first line of the caption or event description."
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "website",
            "instagram",
            "tiktok"
          ],
          "properties": {
            "website": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "instagram": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "tiktok": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          }
        },
        "hours": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opening hours as stated (\"11am-3pm\", \"until sold out\"); null when not given."
        },
        "pay": {
          "type": [
            "string",
            "null"
          ],
          "description": "How to pay as stated (\"cash and Venmo\", \"card only\"); null when not given."
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "URLs that back the listing (the page read, plus any post or article it came with). Written by write.js; records written before it was added lack it until their next merge, so it is not in required."
        },
        "series": {
          "type": [
            "object",
            "null"
          ],
          "description": "Set when the event is one date of a recurring pop-up (data/series.json, ingest/lib/series.js, docs/SERIES.md): id of the series, rule as text, weekdays (0 Sunday to 6 Saturday), until (the last date the series is shown; null when it is open and unconfirmed), source_url of the page that states the rule, projected (true when the date was added from the rule rather than listed by a source). Null for one-off events.",
          "required": [
            "id",
            "rule",
            "weekdays",
            "source_url",
            "projected"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            },
            "weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "until": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_url": {
              "type": "string"
            },
            "projected": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
