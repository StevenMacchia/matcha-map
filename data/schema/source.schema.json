{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source",
  "description": "One entry of data/sources.json (an array of these).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "brand",
    "kind",
    "category",
    "home_city",
    "home_state",
    "website",
    "instagram",
    "tiktok",
    "schedule_url",
    "schedule_kind",
    "adapter",
    "active",
    "notes",
    "added",
    "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "popup",
        "cafe",
        "venue",
        "tea-brand",
        "organizer",
        "festival"
      ],
      "description": "What sort of source this is. The site shows popup by default; the filter widens to the rest. See data/KINDS.md."
    },
    "category": {
      "enum": [
        "matcha",
        "coffee",
        "boba",
        "bakery",
        "dessert",
        "other"
      ],
      "description": "What the brand mainly serves. matcha for everything today."
    },
    "kind_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "One short line on why, for anything that is not popup; null otherwise."
    },
    "home_city": {
      "type": "string"
    },
    "home_state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "instagram": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._]+$",
      "description": "Handle without @."
    },
    "tiktok": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._]+$",
      "description": "Handle without @."
    },
    "schedule_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "schedule_kind": {
      "enum": [
        "website",
        "eventbrite",
        "partiful",
        "linktree",
        "ics",
        "rss",
        "manual",
        "none"
      ]
    },
    "adapter": {
      "type": "string",
      "description": "Name of the ingest adapter that reads this source."
    },
    "active": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "verified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Date a human last checked the handles."
    },
    "about": {
      "type": [
        "string",
        "null"
      ],
      "description": "Two-sentence brand story for the rich card."
    },
    "signature_drinks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Drink names as the menu spells them."
    },
    "price_range": {
      "type": [
        "string",
        "null"
      ],
      "description": "For example \"$6 to $9\"."
    },
    "pay": {
      "type": [
        "string",
        "null"
      ],
      "description": "Payment methods when stated."
    },
    "hours_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "Typical pop-up hours when stated."
    },
    "linktree": {
      "type": [
        "string",
        "null"
      ],
      "description": "Linktree or link-in-bio URL."
    }
  }
}
