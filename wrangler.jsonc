{
  // Cloudflare Pages project "matchamap": serves the site/ folder at https://matchamap.app
  // Deploy: npx wrangler pages deploy site --project-name matchamap --branch main
  // The functions/ folder (next to site/) is deployed with it: /api/submit, /api/queue, /api/approve, /api/report, /api/claim, /api/alerts, /api/rsvp.
  "name": "matchamap",
  "compatibility_date": "2026-11-01",
  "pages_build_output_dir": "./site",

  // Self-serve intake storage and the RSVP rows (docs/INTAKE.md). The INTAKE namespace was created on 2026-11-23 with
  // `npx wrangler kv namespace create INTAKE`; the binding below is applied to the Pages project on each deploy.
  "kv_namespaces": [{ "binding": "INTAKE", "id": "eff3acc751394fc98eb87105a4226980" }]

  // INTAKE_TOKEN (the moderator token for /api/queue and /api/approve) is a secret, not a var:
  // `npx wrangler pages secret put INTAKE_TOKEN --project-name matchamap`.
}
