# Copy to .env and fill in. .env is git-ignored. Every key is optional; the map works without them.
# Instagram Graph API (see docs/INSTAGRAM-SETUP.md)
INSTAGRAM_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Brave Search API, for finding new accounts (free plan: 1 request per second)
BRAVE_API_KEY=
# Better geocoding (optional; Nominatim is the default)
MAPBOX_TOKEN=
# Optional Claude step for extraction
CLAUDE_API_KEY=

# Tavily search API (free tier): TikTok and Instagram discovery through search snippets
# Local budget: data/tavily-budget.json (120 credits per run, 900 per month; basic search = 1 credit)
TAVILY_API_KEY=

# Yelp Fusion API (free, no card, 500 calls a day; we stop at 400): rating, hours, phone and a photo on the card.
YELP_API_KEY=

# Self-serve intake (docs/INTAKE.md). Off when unset. INTAKE_URL is the deployed site, INTAKE_TOKEN the moderator secret.
INTAKE_URL=
INTAKE_TOKEN=

# Optional, off by default: an image API draws PNG drink art beside the free SVG (npm run art -- --image-api; 5 images a run, IMAGE_API_MAX to change).
# OpenAI gpt-image-1, quality low, about $0.01-0.02 an image: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Stability Stable Image Core, 3 credits (about $0.03) an image: https://platform.stability.ai/account/keys
STABILITY_API_KEY=
