{
  "name": "matcha-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive map of matcha pop-ups across America: where and when, so you can find one near you on a given day.",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.js",
    "ingest": "node ingest/run.js",
    "test": "node --test",
    "check:jsonld": "node tools/check-jsonld.js",
    "discover": "node ingest/lib/discover.js",
    "review": "node ingest/review.js",
    "shops": "node ingest/shops.js",
    "menus": "node ingest/menus.js",
    "watch": "node ingest/watch.js",
    "watchlist:apply": "node tools/apply-watchlist-additions.js",
    "loop": "node ingest/loop.js",
    "refresh": "node ingest/loop.js --once",
    "brands": "node ingest/brands.js",
    "yelp": "node ingest/yelp.js",
    "clean": "node ingest/clean.js",
    "audit": "node tools/audit-events.js",
    "regeocode": "node ingest/regeocode.js",
    "smoke": "node tools/smoke.js",
    "flyers": "node tools/flyers.js",
    "pages": "node tools/gen-pages.js",
    "og": "node tools/gen-og.js",
    "images": "node tools/shrink-images.js",
    "art": "node tools/illustrate/run.js",
    "feeds": "node tools/gen-feeds.js",
    "event-pages": "node tools/gen-event-pages.js",
    "weekend": "node tools/gen-weekend.js",
    "brand-extras": "node tools/gen-brand-extras.js",
    "sitemap-extras": "node tools/gen-sitemap-extras.js",
    "icons": "node tools/gen-icons.js",
    "deploy": "node tools/sw-version.js && npx wrangler pages deploy site --project-name matchamap --branch main --commit-dirty=true",
    "preview": "wrangler dev",
    "sw-version": "node tools/sw-version.js",
    "search": "node tools/search.js",
    "brands:apply": "node tools/apply-brand-facts.js"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
