{
  "name": "matcha-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive map of matcha pop-ups across America: where and when, so you can find one near you on a given day.",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.js",
    "ingest": "node ingest/run.js",
    "test": "node --test",
    "discover": "node ingest/lib/discover.js",
    "shops": "node ingest/shops.js",
    "watch": "node ingest/watch.js",
    "loop": "node ingest/loop.js",
    "refresh": "node ingest/loop.js --once",
    "brands": "node ingest/brands.js",
    "yelp": "node ingest/yelp.js",
    "clean": "node ingest/clean.js",
    "regeocode": "node ingest/regeocode.js",
    "flyers": "node tools/flyers.js",
    "pages": "node tools/gen-pages.js",
    "og": "node tools/gen-og.js",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
